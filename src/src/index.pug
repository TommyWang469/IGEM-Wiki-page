include templates/mixins

html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title iGEM YOUR_TEAM 2026
    link(rel="preconnect" href="https://fonts.googleapis.com")
    link(rel="preconnect" href="https://fonts.gstatic.com" crossorigin)
    link(href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;700;900&family=Rajdhani:wght@300;400;600&display=swap" rel="stylesheet")

  body.home-page

    //- Custom cursor
    .cursor
    .cursor-follower

    //- Generated visual layer for the homepage
    .hero-backdrop(aria-hidden="true")
      img(src=require('./assets/img/Home--synthetic-lab.png')['default'] alt='')
      .hero-backdrop-shade

    //- Three.js canvas (full screen background)
    canvas#hero-canvas

    //- Navigation
    include templates/nav.pug

    //- Hero overlay
    .hero-overlay
      .hero-inner
        .hero-badge
          span.badge-dot
          | iGEM 2026 Competition
        h1.hero-title
          span.title-line YOUR
          span.title-line.accent TEAM
        p.hero-tagline A living engineering notebook for the ideas, experiments, people, and design decisions behind our synthetic biology project.
        .hero-cta
          a.btn-primary-glow(href='/Description') Explore Project
          a.btn-outline-glow(href='/Engineering') Engineering Cycle
        .hero-metrics(aria-label="Wiki highlights")
          .hero-metric
            strong 12
            span wiki pages
          .hero-metric
            strong 04
            span project tracks
          .hero-metric
            strong 01
            span team story

      .hero-lab-card
        p.lab-card-kicker Live Wiki Map
        h2 From question to construct
        .lab-card-flow
          a.flow-step(href='/Description')
            span 01
            strong Frame
          a.flow-step(href='/Design')
            span 02
            strong Design
          a.flow-step(href='/Experiments')
            span 03
            strong Test
          a.flow-step(href='/Results')
            span 04
            strong Learn
        p.lab-card-note Follow the path from biological context to implementation, then see how human practices and safety shaped each decision.
        .hero-scroll-hint
          span Scroll to explore
          .scroll-line

    //- Sections
    main#main-content
      section.container.story-panel
        .story-copy
          p.section-label // PROJECT COMPASS //
          h2.section-heading Build the story as the science grows
          p.story-lede The wiki is set up as a complete competition home base: project context, design reasoning, experimental work, notebook records, safety, parts, human practices, and team contributions.
        .story-board
          .story-node.is-active
            i.fas.fa-dna
            span Define the biology
          .story-node
            i.fas.fa-pencil-ruler
            span Design the system
          .story-node
            i.fas.fa-flask
            span Run the experiments
          .story-node
            i.fas.fa-chart-line
            span Share the evidence

      section.container.visual-showcase
        .showcase-media
          img(src=require('./assets/img/Home--synthetic-lab.png')['default'] alt='Cinematic synthetic biology lab bench with DNA hologram')
        .showcase-copy
          p.section-label // FRONT PAGE //
          h2.section-heading A sharper first impression
          p This homepage now combines a generated project visual, the existing 3D DNA animation, and fast routes into every major wiki section. The layout is built to work before the final project content is ready, then become richer as your team replaces the placeholder pages.
          a.showcase-link(href='/Notebook')
            span Open Notebook
            i.fas.fa-arrow-right

      section.container.sections-grid
        p.section-label // NAVIGATE //
        h2.section-heading What We're Doing

        .row.g-4
          .col-md-4
            .section-card(data-color="cyan")
              .card-accent
              .card-number 01
              .card-icon: i.fas.fa-dna
              h4 Project Description
              p Understand our biological problem, why it matters, and the synthetic biology solution we designed.
              a.card-link(href='/Description')
                span Explore
                i.fas.fa-arrow-right

          .col-md-4
            .section-card(data-color="purple")
              .card-accent
              .card-number 02
              .card-icon: i.fas.fa-pencil-ruler
              h4 Design
              p The engineering design cycle — from concept through iteration to our final construct design.
              a.card-link(href='/Design')
                span Explore
                i.fas.fa-arrow-right

          .col-md-4
            .section-card(data-color="teal")
              .card-accent
              .card-number 03
              .card-icon: i.fas.fa-chart-line
              h4 Results
              p Our experimental outcomes, data analysis, and what we learned from the lab.
              a.card-link(href='/Results')
                span Explore
                i.fas.fa-arrow-right

          .col-md-4
            .section-card(data-color="purple")
              .card-accent
              .card-number 04
              .card-icon: i.fas.fa-flask
              h4 Experiments
              p Detailed protocols and methods behind every experiment we ran.
              a.card-link(href='/Experiments')
                span Explore
                i.fas.fa-arrow-right

          .col-md-4
            .section-card(data-color="cyan")
              .card-accent
              .card-number 05
              .card-icon: i.fas.fa-globe
              h4 Human Practices
              p How we engaged with experts and stakeholders to shape a responsible project.
              a.card-link(href='/Human_Practices')
                span Explore
                i.fas.fa-arrow-right

          .col-md-4
            .section-card(data-color="teal")
              .card-accent
              .card-number 06
              .card-icon: i.fas.fa-users
              h4 Our Team
              p Meet the people who made this project happen — students, advisors, and PI.
              a.card-link(href='/Team')
                span Explore
                i.fas.fa-arrow-right

      section.container.featured-routes
        p.section-label // WIKI ROUTES //
        h2.section-heading Start with a lens
        .route-grid
          a.route-card(href='/Design')
            img(src=require('./assets/img/Home--design.jpeg')['default'] alt='Design planning visual')
            .route-card-body
              span Route 01
              h3 Design Logic
              p Trace decisions from problem framing to biological architecture.
          a.route-card(href='/Human_Practices')
            img(src=require('./assets/img/Home--human-practices.jpg')['default'] alt='Human practices discussion visual')
            .route-card-body
              span Route 02
              h3 Human Practices
              p See how stakeholder input and responsibility shape the project.
          a.route-card(href='/Results')
            img(src=require('./assets/img/Home--model.jpeg')['default'] alt='Modeling and results visual')
            .route-card-body
              span Route 03
              h3 Data & Results
              p Move from experimental evidence toward conclusions and next steps.

      section.container.home-cta
        p.section-label // READY //
        h2.section-heading Keep building
        p Replace the starter copy page by page, drop in real team photography, and let the front page become the launch pad for your finished iGEM story.
        .hero-cta
          a.btn-primary-glow(href='/Team') Meet the Team
          a.btn-outline-glow(href='/Safety') Safety

    include templates/footer.pug
